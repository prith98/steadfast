# LLM API keys.
#
# Steadfast requires an OpenAI key for *benchmark infrastructure*
# (paraphrase generation, embedding similarity, default rubric judge),
# regardless of which target model is being evaluated. This is documented
# in docs/adr/0001-infrastructure-model.md.
#
# Anthropic and Google keys are required only when those providers are the
# target of a benchmark run.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional — OTel exporter configuration. Leave unset for the console exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=

# Optional — OpenAI rate-limit-tier knobs. The gpt-5.2 free tier is 3 RPM,
# which collides with the default 5-way concurrent fanout (paraphrase
# generator + validator + pairwise rubric + outcome judge). Lower these
# for accounts on a low rate-limit tier; the existing tenacity retry layer
# (capped at 30s exponential backoff) covers the 20s rate-limit window.
# STEADFAST_OPENAI_MAX_CONCURRENT=1
# STEADFAST_OPENAI_MAX_RETRIES=10
