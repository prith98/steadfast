# LLM API keys.
#
# Steadfast requires an OpenAI key for *benchmark infrastructure*
# (paraphrase generation, embedding similarity, default rubric judge),
# regardless of which target model is being evaluated. This is documented
# in docs/adr/0001-infrastructure-model.md.
#
# Anthropic and Google keys are required only when those providers are the
# target of a benchmark run.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional — OTel exporter configuration. Leave unset for the console exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
